{
  "name": "@waganda/agent",
  "version": "0.1.0",
  "private": true,
  "description": "Strands 기반 분석 에이전트 (AgentCore Runtime, ARM64)",
  "type": "module",
  "main": "dist/entrypoint.js",
  "scripts": {
    "build": "esbuild src/entrypoint.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/entrypoint.js --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "dev": "tsx watch src/entrypoint.ts",
    "start": "node dist/entrypoint.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "3.1097.0",
    "@aws-sdk/client-cloudfront": "3.1097.0",
    "@aws-sdk/client-dynamodb": "3.1097.0",
    "@aws-sdk/client-lambda": "3.1097.0",
    "@aws-sdk/client-s3": "3.1097.0",
    "@aws-sdk/client-transcribe": "3.1097.0",
    "@aws-sdk/lib-dynamodb": "3.1097.0",
    "@modelcontextprotocol/sdk": "1.25.2",
    "@opentelemetry/api": "1.9.0",
    "@strands-agents/sdk": "1.11.2",
    "@waganda/schemas": "*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "esbuild": "0.25.12",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
