# 필요한 환경변수 목록. **값은 비워 둔다** — 실제 값은 커밋하지 않는다.
#
# 운영 환경의 원본은 SSM Parameter Store SecureString 이며(/waganda/<env>/...),
# 로컬에서는 이 파일을 `.env.local` 로 복사해 더미 값을 채워 쓴다.
# `.env.local` 은 .gitignore 로 차단되어 있다.

# ── 런타임 ───────────────────────────────────────────────
WAGANDA_ENV=            # local | dev | prod
AWS_REGION=
WAGANDA_TABLE_NAME=
WAGANDA_MEDIA_BUCKET=
APP_BASE_URL=

# ── 선택: 쓰기 후 CDN 무효화 / 에이전트 호출 ─────────────
WAGANDA_CF_DISTRIBUTION_ID=
WAGANDA_AGENT_RUNTIME_ARN=
WAGANDA_AUDIO_LAMBDA=

# ── 가드레일 (R10) ───────────────────────────────────────
WAGANDA_DAILY_AGENT_RUN_LIMIT=
WAGANDA_MONTHLY_MODEL_BUDGET_USD=

# ── 인증 (시크릿 — 실제 값을 여기에 적지 말 것) ──────────
# 미설정 시 lib/config.ts 가 SSM 에서 조회한다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EDITOR_JWT_SECRET=
EDITOR_ALLOWLIST=       # 콤마 구분 이메일
EDITOR_SESSION_TTL_SEC=

# ── 로컬·E2E 전용 ────────────────────────────────────────
# 값이 있을 때만 DynamoDB 엔드포인트를 덮어쓴다 (DynamoDB Local).
# 설정 시 `npm run db:up` 으로 컨테이너를 띄워야 한다 (`npm run dev` 는 자동 기동).
WAGANDA_DDB_ENDPOINT=
# 값이 있을 때만 S3 엔드포인트를 덮어쓴다 (LocalStack). `npm run s3:up` 으로 기동.
WAGANDA_S3_ENDPOINT=

# ── 모델·인식 (선택) ────────────────────────────────────
# Bedrock 추론 프로파일 ID. 온디맨드 모델 ID 는 거부되므로 프로파일 ID 를 쓴다.
WAGANDA_BEDROCK_MODEL_ID=
# `bedrock` 으로 두면 AgentCore 없이 Bedrock 을 직접 호출해 라벨을 인식한다 (로컬 확인용).
WAGANDA_LABEL_FALLBACK=
# Transcribe 입력을 올릴 버킷 (미디어 버킷과 리전이 다를 때 필요).
WAGANDA_TRANSCRIBE_BUCKET=

# ── 라벨 보강용 웹 검색 (선택) ──────────────────────────
# SerpAPI 키를 넣으면 품종·지역을 검색 근거로 채우고 출처 URL 을 저장한다.
# 비워 두면 모델 지식만으로 채우고(confidence: low) 출처는 남기지 않는다.
# 무료 티어는 월 호출 수가 제한되므로, 빈 필드가 있을 때만 1회 호출하고 같은 질의는 캐시한다.
SERPAPI_KEY=

# 녹음 저장 직후 분석 파이프라인을 자동 실행한다 (로컬 전용)
# 켜면 저장할 때마다 실제 Transcribe·Bedrock 을 호출한다 — 녹음 1건당 2~3센트.
WAGANDA_LOCAL_PIPELINE=1
